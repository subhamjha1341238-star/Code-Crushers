{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with learning statistics, current streak, and active learning goals.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "streakCount": { "type": "number" },
        "totalXP": { "type": "number" },
        "totalStepsCompleted": { "type": "number" },
        "activeSkillGoal": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "email"]
    },
    "LearningSession": {
      "title": "LearningSession",
      "description": "Persisted live telemetry session with performance metrics and adaptive layout transitions.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "skillGoal": { "type": "string", "maxLength": 200 },
        "currentFocusScore": { "type": "number" },
        "momentumStatus": { "type": "string", "maxLength": 100 },
        "adaptiveLayout": { "type": "string", "maxLength": 50 },
        "stepsCompleted": { "type": "number" },
        "timeSpentSec": { "type": "number" },
        "hintsClicked": { "type": "number" },
        "quizAttempts": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["sessionId", "userId", "skillGoal"]
    },
    "SavedRoadmap": {
      "title": "SavedRoadmap",
      "description": "User saved skill roadmaps with Mermaid diagrams and customized curriculum steps.",
      "type": "object",
      "properties": {
        "roadmapId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "skillGoal": { "type": "string", "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 1000 },
        "mermaidRoadmap": { "type": "string", "maxLength": 8000 },
        "stepsCount": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["roadmapId", "userId", "skillGoal", "mermaidRoadmap"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores individual user profile and overall gamification stats."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "LearningSession",
      "description": "Stores user live learning telemetry and performance records."
    },
    "/users/{userId}/roadmaps/{roadmapId}": {
      "schema": "SavedRoadmap",
      "description": "Stores user personalized skill roadmaps and diagrams."
    }
  }
}
